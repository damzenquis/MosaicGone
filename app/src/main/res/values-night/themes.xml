<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark: every Material role is set, so dialogs, menus, fields, check boxes and bars are all dark too. -->
    <style name="Theme.MosaicGone" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/dark_accent_container</item>
        <item name="colorOnPrimaryContainer">@color/dark_on_accent_container</item>
        <item name="colorPrimaryInverse">#2B6CB0</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/dark_accent_container</item>
        <item name="colorOnSecondaryContainer">@color/dark_on_accent_container</item>
        <item name="colorTertiary">@color/accent</item>
        <item name="colorOnTertiary">@color/on_accent</item>
        <item name="colorTertiaryContainer">@color/dark_accent_container</item>
        <item name="colorOnTertiaryContainer">@color/dark_on_accent_container</item>
        <item name="colorError">@color/dark_error</item>
        <item name="colorOnError">@color/dark_on_error</item>

        <item name="android:colorBackground">@color/window_bg</item>
        <item name="colorOnBackground">@color/ink</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/dark_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorSurfaceInverse">@color/ink</item>
        <item name="colorOnSurfaceInverse">@color/surface</item>
        <item name="colorSurfaceDim">@color/window_bg</item>
        <item name="colorSurfaceBright">@color/dark_surface_bright</item>
        <item name="colorSurfaceContainerLowest">@color/dark_surface_lowest</item>
        <item name="colorSurfaceContainerLow">@color/dark_surface_low</item>
        <item name="colorSurfaceContainer">@color/dark_surface_mid</item>
        <item name="colorSurfaceContainerHigh">@color/dark_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/dark_surface_highest</item>
        <item name="colorOutline">@color/dark_outline</item>
        <item name="colorOutlineVariant">@color/line</item>

        <item name="android:textColorLink">@color/accent</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/bars</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bars</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
