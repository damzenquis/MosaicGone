    <color name="window_bg">#ECECEC</color>
    <color name="surface">#FFFFFF</color>
    <color name="ink">#1D1D1D</color>
    <color name="muted">#6B6B6B</color>
    <color name="placeholder">#9A9A9A</color>
    <color name="line">#C9C9C9</color>
