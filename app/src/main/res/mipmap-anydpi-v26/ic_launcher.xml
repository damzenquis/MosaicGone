<?xml version="1.0" encoding="utf-8"?>
<!-- lint (MonochromeLauncherIcon): no single-colour version yet, so with Android 13's "themed icons" the launcher keeps
     the full-colour logo; add <monochrome> when a one-colour MG mark is drawn -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MonochromeLauncherIcon">
    <background android:drawable="@color/icon_bg" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
